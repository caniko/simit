watch_file flake.nix flake.lock
watch_file ../nix-opencode-lsp/lib/default.nix ../nix-opencode-lsp/flake.nix ../nix-opencode-lsp/flake.lock
use flake . || return 1
# Separate caches: nix-direnv removes old profiles within the active layout.
direnv_layout_dir="$(direnv_layout_dir)/opencode-lsp" use flake git+https://github.com/caniko/harbor-rs.git#opencode-lsp --override-input nix-opencode-lsp path:../nix-opencode-lsp
