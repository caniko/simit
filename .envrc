watch_file flake.nix flake.lock
watch_file ../nix-opencode-lsp/lib/default.nix ../nix-opencode-lsp/flake.nix ../nix-opencode-lsp/flake.lock
use flake . || return 1
# Separate caches: nix-direnv removes old profiles within the active layout.
direnv_layout_dir="$(direnv_layout_dir)/opencode-lsp" use flake 'git+https://github.com/caniko/harbor.git?ref=feat/harbor-monorepo-components&rev=7d99eb50c52d0a941e2996b97c469b32a7657ef4#rust-opencode-lsp' --override-input nix-opencode-lsp path:../nix-opencode-lsp
