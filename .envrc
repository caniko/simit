strict_env

watch_file flake.nix flake.lock Cargo.toml Cargo.lock
watch_dir nix
nix_direnv_disallow_fallback
use flake "git+file://$PWD" --no-update-lock-file || return 1
# Worktrees may not have the optional sibling language-server checkout.
if test -f ../nix-opencode-lsp/flake.nix; then
  watch_file ../nix-opencode-lsp/lib/default.nix ../nix-opencode-lsp/flake.nix ../nix-opencode-lsp/flake.lock
  # Separate caches: nix-direnv removes old profiles within the active layout.
  # The local LSP override changes the input graph without writing its lock file.
  simit_lsp_root="$(cd -P ../nix-opencode-lsp && pwd -P)"
  direnv_layout_dir="$(direnv_layout_dir)/opencode-lsp" use flake 'git+https://github.com/caniko/harbor.git?ref=feat/harbor-monorepo-components&rev=e8b1996580e4ecd51dd402edf4a16d9df88e3a1b#rust-opencode-lsp' --override-input nix-opencode-lsp "git+file://$simit_lsp_root" --no-write-lock-file || return 1
  unset simit_lsp_root
fi
export PROJECT_DEV_SHELL_ACTIVE=default
